# Market data provider: yahoo | mock | databento
MARKET_DATA_PROVIDER=yahoo

# Cache: leave REDIS_URL empty to use the disk fallback under CACHE_DIR.
REDIS_URL=
CACHE_DIR=.cache
CACHE_ENABLED=true
CACHE_TTL_RAW=300
CACHE_TTL_FEATURE=600
CACHE_TTL_REGIME=900

# Provider reliability (retry / timeout / circuit breaker)
PROVIDER_TIMEOUT=20
PROVIDER_MAX_RETRIES=3
PROVIDER_BREAKER_FAIL_MAX=5
PROVIDER_BREAKER_RESET=30

# Observability
LOG_LEVEL=INFO
LOG_JSON=true

# Bump to invalidate ALL cached feature/regime outputs at once.
FEATURE_VERSION=v1
